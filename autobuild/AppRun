#!/bin/sh
# Bluelium : lanceur de l'AppImage (repris du lanceur AppImage de Helium,
# GPL-3.0, The Helium Authors).
THIS="$(readlink -f "${0}")"
HERE="$(dirname "${THIS}")"
export LD_LIBRARY_PATH="${HERE}/opt/bluelium:${HERE}/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export CHROME_WRAPPER="${APPIMAGE:-$THIS}"
export CHROME_VERSION_EXTRA=appimage

AA_PROFILE_PATH=/etc/apparmor.d/bluelium-appimage
AA_SYSFS_USERNS_PATH=/proc/sys/kernel/apparmor_restrict_unprivileged_userns

has_command() {
    [ -x "$(command -v "$1")" ]
}

sudo_shim() {
    if [ "$(id -u)" = 0 ]; then
        (set -x; "$@")
    elif has_command pkexec; then
        (set -x; exec pkexec "$@")
    elif has_command sudo; then
        (set -x; exec sudo "$@")
    elif has_command su; then
        (set -x; exec su -c "$*")
    else
        return 1
    fi
}

print_apparmor_profile() {
    APPIMAGE_ESC=$(echo "$APPIMAGE" | sed 's/"/\\"/g' | tr -d '\n')
    echo 'abi <abi/4.0>,'
    echo 'include <tunables/global>'
    echo
    echo 'profile bluelium-appimage "'"$APPIMAGE_ESC"'" flags=(default_allow) {'
    echo '  userns,'
    echo '  include if exists <local/bluelium-appimage>'
    echo '}'
}

needs_apparmor_bootstrap() {
    [ "$APPARMOR_BOOTSTRAPPED" != 1 ] \
        && [ -n "$APPIMAGE" ] \
        && [ -f $AA_SYSFS_USERNS_PATH ] \
        && [ 0 != "$(cat $AA_SYSFS_USERNS_PATH)" ] \
        && has_command aa-enabled \
        && has_command apparmor_parser \
        && [ "$(aa-enabled)" = Yes ] \
        && [ -d /etc/apparmor.d ] \
        && {
            ! [ -f "$AA_PROFILE_PATH" ] \
            || [ "$(print_apparmor_profile)" != "$(cat $AA_PROFILE_PATH)" ]
        }
}

if needs_apparmor_bootstrap; then
    echo "Bluelium : AppArmor détecté, création d'un profil (droits root demandés)." >&2
    print_apparmor_profile | sudo_shim tee "$AA_PROFILE_PATH" >/dev/null && \
        sudo_shim chmod 644 "$AA_PROFILE_PATH" && \
        sudo_shim apparmor_parser -r "$AA_PROFILE_PATH" && \
        APPARMOR_BOOTSTRAPPED=1 exec "$APPIMAGE" "$@"
fi

# Charger le script avant détachement : il reste utilisable après démontage.
# Tout échec de préparation est isolé du lancement du navigateur.
(
    [ "${BLUELIUM_NO_UPDATE:-}" != 1 ] || exit 0
    [ ! -e "$HOME/.config/bluelium/no-appimage-update" ] || exit 0
    [ -n "$APPIMAGE" ] && [ -f "$APPIMAGE" ] && [ -w "$APPIMAGE" ] || exit 0
    [ -w "$(dirname "$(readlink -f "$APPIMAGE")")" ] || exit 0
    cache=${XDG_CACHE_HOME:-$HOME/.cache}/bluelium
    mkdir -p "$cache" || exit 0
    updater=$(cat "$HERE/opt/bluelium/appimage-update") || exit 0
    version=$(cat "$HERE/opt/bluelium/VERSION") || exit 0
    nohup nice -n 19 sh -c "$updater" appimage-update "$APPIMAGE" "$version" \
        </dev/null >>"$cache/appimage-update.log" 2>&1 &
) 2>/dev/null

# Identité propre, distincte de Helium installé à côté :
#  - profil ~/.config/bluelium : avec le profil de Helium, lancer l'un ouvrait
#    une fenêtre dans l'autre (verrou de profil partagé) ;
#  - nom d'application « bluelium » (app_id Wayland, WM_CLASS X11) : la barre
#    des tâches ne les confond plus.
# Variables plutôt que --user-data-dir : l'option ajouterait le chemin au
# WM_CLASS, que StartupWMClass ne reconnaîtrait plus.
CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}
PROFILE=$CONFIG/bluelium
HELIUM_PROFILE=$CONFIG/net.imput.helium
export CHROME_DESKTOP=bluelium.desktop

# Version en cours, pour le détecteur de mise à jour du navigateur ; une mise
# à jour signalée et désormais lancée n'a plus lieu d'être affichée.
BLUELIUM_VERSION=$(cat "$HERE/opt/bluelium/VERSION" 2>/dev/null || :)
export BLUELIUM_VERSION
ready=${XDG_CACHE_HOME:-$HOME/.cache}/bluelium/update-ready
if [ -n "$BLUELIUM_VERSION" ] && [ "$(cat "$ready" 2>/dev/null)" = "$BLUELIUM_VERSION" ]; then
    rm -f "$ready"
fi
export CHROME_USER_DATA_DIR="$PROFILE"

say() {
    echo "Bluelium : $1" >&2
    has_command notify-send && notify-send -a Bluelium -i bluelium "Bluelium" "$1" 2>/dev/null || true
}

# Une seule fois : copie du profil Helium (où vivaient jusqu'ici les données
# de Bluelium). Ensuite les deux profils évoluent chacun de leur côté.
if [ ! -e "$PROFILE/Local State" ] && [ -e "$HELIUM_PROFILE/Local State" ] \
   && [ "${BLUELIUM_NO_IMPORT:-}" != 1 ]; then
    lock=$(readlink "$HELIUM_PROFILE/SingletonLock" 2>/dev/null || true)
    if [ -n "$lock" ] && kill -0 "${lock##*-}" 2>/dev/null; then
        say "fermez Helium puis relancez Bluelium : son profil sera copié une fois."
        exit 1
    fi
    say "copie de votre profil Helium, une seule fois…"
    mkdir -p "$PROFILE"
    if cp -a "$HELIUM_PROFILE/." "$PROFILE/"; then
        rm -f "$PROFILE/SingletonLock" "$PROFILE/SingletonSocket" "$PROFILE/SingletonCookie"
        date > "$PROFILE/.copie-depuis-helium"
    else
        rm -f "$PROFILE/Local State"   # copie incomplète : on réessaiera
        say "copie du profil Helium impossible (place disque ?)."
        exit 1
    fi
fi

exec "${HERE}/opt/bluelium/helium" "$@"
