#!/usr/bin/env python3
"""Bluelium (macOS) — mise à jour automatique depuis les releases GitHub.

  bluelium-update-macos            vérifie, télécharge et installe (ou prépare)
  bluelium-update-macos --status   affiche les versions installée, prête, publiée

Cherche dans les releases de BLUELIUM_REPO le .dmg macOS le plus récent
(bluelium-<version>-macos-<arch>.dmg et son .sha256, publiés par
scripts/package-macos.sh). La nouvelle version n'est installée que si
Bluelium est fermé ; sinon elle est préparée dans Bluelium.staged.app et
installée au passage suivant (agent launchd, toutes les 2 h et à la connexion).
La version précédente reste dans Bluelium.previous.app.
"""
import hashlib
import json
import os
import platform
import plistlib
import shutil
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
from pathlib import Path

APPS = Path(os.environ.get('BLUELIUM_APPS', Path.home() / 'Applications'))
APP = APPS / 'Bluelium.app'
STAGED = APPS / 'Bluelium.staged.app'
PREVIOUS = APPS / 'Bluelium.previous.app'
STATE = Path.home() / 'Library' / 'Application Support' / 'Bluelium' / 'update.json'
REPO = os.environ.get('BLUELIUM_REPO', 'matthieuleconte1/bluelium')
ARCH = 'arm64' if platform.machine() == 'arm64' else 'x86_64'
SUFFIX = f'-macos-{ARCH}.dmg'


def notify(title, body=''):
  print(f'{title} {body}'.strip())
  script = f'display notification {json.dumps(body)} with title {json.dumps(title)}'
  subprocess.run(['osascript', '-e', script], check=False,
                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def http(url, accept='application/octet-stream'):
  request = urllib.request.Request(url, headers={
      'Accept': accept, 'User-Agent': 'bluelium-update'})
  return urllib.request.urlopen(request, timeout=60)


def latest_release():
  """Release la plus récente avec un .dmg macOS : dict ou None."""
  url = f'https://api.github.com/repos/{REPO}/releases?per_page=30'
  try:
    with http(url, 'application/vnd.github+json') as response:
      releases = json.load(response)
  except urllib.error.HTTPError as error:
    if error.code == 404:
      return None
    raise
  for release in releases:  # du plus récent au plus ancien
    if release.get('draft') or release.get('prerelease'):
      continue
    assets = {a['name']: a['browser_download_url'] for a in release.get('assets', [])}
    dmg = next((n for n in assets if n.endswith(SUFFIX)), None)
    if dmg and dmg + '.sha256' in assets:
      with http(assets[dmg + '.sha256']) as response:
        sha = response.read().decode().split()[0]
      version = dmg.removeprefix('bluelium-').removesuffix(SUFFIX)
      return {'version': version, 'file': dmg, 'url': assets[dmg], 'sha256': sha}
  return None


def version_of(app):
  try:
    with (app / 'Contents' / 'Info.plist').open('rb') as f:
      return plistlib.load(f).get('BlueliumVersion')
  except (OSError, plistlib.InvalidFileException):
    return None


def load_state():
  try:
    return json.loads(STATE.read_text())
  except (OSError, ValueError):
    return {}


def save_state(state):
  STATE.parent.mkdir(parents=True, exist_ok=True)
  STATE.write_text(json.dumps(state, indent=1))


def running():
  """Vrai si un processus tourne depuis Bluelium.app."""
  result = subprocess.run(['pgrep', '-f', f'{APP.resolve()}/Contents/'],
                          stdout=subprocess.DEVNULL)
  return result.returncode == 0


def apply_staged():
  version = version_of(STAGED)
  if not version or running():
    return False
  if PREVIOUS.exists():
    shutil.rmtree(PREVIOUS)
  if APP.exists():
    APP.rename(PREVIOUS)
  STAGED.rename(APP)
  notify('Bluelium mis à jour', version)
  return True


def download(latest):
  with tempfile.TemporaryDirectory(prefix='bluelium-update-') as tmp:
    dmg = Path(tmp) / latest['file']
    with http(latest['url']) as response, dmg.open('wb') as out:
      shutil.copyfileobj(response, out, 1 << 20)
    digest = hashlib.sha256()
    with dmg.open('rb') as f:
      for block in iter(lambda: f.read(1 << 20), b''):
        digest.update(block)
    if digest.hexdigest() != latest['sha256']:
      raise RuntimeError('empreinte SHA-256 différente : téléchargement rejeté')
    mount = Path(tmp) / 'mnt'
    mount.mkdir()
    subprocess.run(['hdiutil', 'attach', '-quiet', '-nobrowse', '-readonly',
                    '-mountpoint', str(mount), str(dmg)], check=True)
    try:
      if version_of(mount / 'Bluelium.app') != latest['version']:
        raise RuntimeError('paquet incohérent (BlueliumVersion)')
      if STAGED.exists():
        shutil.rmtree(STAGED)
      APPS.mkdir(parents=True, exist_ok=True)
      subprocess.run(['ditto', str(mount / 'Bluelium.app'), str(STAGED)], check=True)
    finally:
      subprocess.run(['hdiutil', 'detach', '-quiet', str(mount)], check=False)
  subprocess.run(['codesign', '--verify', '--deep', '--strict', str(STAGED)], check=True)


def check():
  state = load_state()
  if version_of(STAGED):
    apply_staged()
  latest = latest_release()
  if not latest:
    print('Aucune version macOS publiée pour l’instant.')
    return
  if latest['version'] in (version_of(APP), version_of(STAGED)):
    print(f'À jour : {version_of(APP) or "build manuel"} (publiée : {latest["version"]})')
  else:
    download(latest)
  if version_of(STAGED) and not apply_staged():
    if state.get('pending') != version_of(STAGED):
      notify('Mise à jour de Bluelium prête',
             f'{version_of(STAGED)} — installée quand Bluelium sera fermé.')
      state['pending'] = version_of(STAGED)
      save_state(state)


def main():
  arg = sys.argv[1] if len(sys.argv) > 1 else ''
  if arg == '--status':
    print('installée :', version_of(APP) or '—')
    print('prête     :', version_of(STAGED) or '—')
    print('publiée   :', (latest_release() or {}).get('version', '—'))
  elif arg in ('', '--check'):
    check()
  else:
    print(__doc__)
    sys.exit(2)


if __name__ == '__main__':
  try:
    main()
  except (subprocess.CalledProcessError, RuntimeError, OSError,
          ValueError) as error:
    print(f'bluelium-update-macos : {error}', file=sys.stderr)
    sys.exit(1)
