[Unit]
Description=Bluelium — auto-build (nouvelle version de Helium ou patchs Glyphe modifiés)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/root/glyphe/autobuild/autobuild.sh
Nice=10
IOSchedulingClass=idle
# x86_64 (PGO) puis arm64 : deux compilations complètes.
TimeoutStartSec=12h
