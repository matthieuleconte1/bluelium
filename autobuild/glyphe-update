#!/usr/bin/env python3
"""Bluelium — mise à jour automatique depuis les releases GitHub.

  glyphe-update                 vérifie, télécharge et installe (ou prépare)
  glyphe-update --apply-staged  installe la version préparée si Helium est fermé
  glyphe-update --status        affiche les versions installée, prête et publiée

Les versions sont publiées par l'auto-build (autobuild/autobuild.sh) comme
releases de BLUELIUM_REPO : une archive .tar.zst et son .sha256.

La nouvelle version est installée seulement quand aucune fenêtre de Bluelium
n'est ouverte : sinon elle est préparée à côté
(~/Applications/helium-glyphe.staged) et installée au prochain lancement par
helium-wrapper. La version précédente reste dans helium-glyphe.previous.
"""
import hashlib
import json
import os
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

APP = Path.home() / 'Applications' / 'helium-glyphe'
STAGED = APP.with_name(APP.name + '.staged')
PREVIOUS = APP.with_name(APP.name + '.previous')
DOWNLOAD = APP.with_name('.helium-glyphe-download')
STATE = Path.home() / '.local' / 'state' / 'glyphe-update.json'
REPO = os.environ.get('BLUELIUM_REPO', 'matthieuleconte1/bluelium')
API = f'https://api.github.com/repos/{REPO}/releases/latest'


def notify(title, body=''):
  print(f'{title} {body}'.strip())
  subprocess.run(['notify-send', '-a', 'Bluelium', '-i', 'net.imput.helium',
                  title, body], check=False, stderr=subprocess.DEVNULL)


def http(url, accept='application/octet-stream'):
  request = urllib.request.Request(url, headers={
      'Accept': accept, 'User-Agent': 'bluelium-update'})
  return urllib.request.urlopen(request, timeout=60)


def latest_release():
  """Dernière release : {'version', 'file', 'url', 'sha256'} ou None."""
  try:
    with http(API, 'application/vnd.github+json') as response:
      release = json.load(response)
  except urllib.error.HTTPError as error:
    if error.code == 404:
      return None
    raise
  assets = {a['name']: a['browser_download_url'] for a in release.get('assets', [])}
  archive = next((n for n in assets if n.endswith('.tar.zst')), None)
  if not archive or archive + '.sha256' not in assets:
    return None
  with http(assets[archive + '.sha256']) as response:
    sha = response.read().decode().split()[0]
  return {'version': release['tag_name'].removeprefix('v'), 'file': archive,
          'url': assets[archive], 'sha256': sha}


def version_of(path):
  try:
    return (path / 'VERSION').read_text().strip()
  except OSError:
    return None


def load_state():
  try:
    return json.loads(STATE.read_text())
  except (OSError, ValueError):
    return {}


def save_state(state):
  STATE.parent.mkdir(parents=True, exist_ok=True)
  STATE.write_text(json.dumps(state, indent=1))


def running():
  """Vrai si un processus tourne depuis le dossier de l'application."""
  prefix = str(APP.resolve()) + '/'
  for proc in Path('/proc').iterdir():
    if proc.name.isdigit():
      try:
        if os.readlink(proc / 'exe').startswith(prefix):
          return True
      except OSError:
        pass
  return False


def apply_staged():
  version = version_of(STAGED)
  if not version or not (STAGED / 'helium').is_file():
    return False
  if running():
    return False
  if PREVIOUS.exists():
    shutil.rmtree(PREVIOUS)
  if APP.exists():
    APP.rename(PREVIOUS)
  STAGED.rename(APP)
  notify('Bluelium mis à jour', version)
  return True


def download(latest):
  if DOWNLOAD.exists():
    shutil.rmtree(DOWNLOAD)
  DOWNLOAD.mkdir(parents=True)
  archive = DOWNLOAD / latest['file']
  with http(latest['url']) as response, archive.open('wb') as out:
    shutil.copyfileobj(response, out, 1 << 20)
  digest = hashlib.sha256()
  with archive.open('rb') as f:
    for block in iter(lambda: f.read(1 << 20), b''):
      digest.update(block)
  if digest.hexdigest() != latest['sha256']:
    raise RuntimeError('empreinte SHA-256 différente : téléchargement rejeté')
  subprocess.run(['tar', '--zstd', '-xf', str(archive), '-C', str(DOWNLOAD)], check=True)
  extracted = DOWNLOAD / archive.name.removesuffix('.tar.zst')
  if version_of(extracted) != latest['version']:
    raise RuntimeError('paquet incohérent (VERSION)')
  if STAGED.exists():
    shutil.rmtree(STAGED)
  extracted.rename(STAGED)
  shutil.rmtree(DOWNLOAD)


def check():
  state = load_state()
  latest = latest_release()
  if not latest:
    print('Aucune version publiée pour l’instant.')
    return
  if latest['version'] in (version_of(APP), version_of(STAGED)):
    print(f'À jour : {version_of(APP) or "build manuel"} (publiée : {latest["version"]})')
  else:
    download(latest)
  if version_of(STAGED) and not apply_staged():
    if state.get('pending') != version_of(STAGED):
      notify('Mise à jour de Bluelium prête',
             f'{version_of(STAGED)} — installée à la prochaine ouverture.')
      state['pending'] = version_of(STAGED)
      save_state(state)


def main():
  arg = sys.argv[1] if len(sys.argv) > 1 else ''
  if arg == '--apply-staged':
    apply_staged()
  elif arg == '--status':
    print('installée :', version_of(APP) or 'build manuel (sans VERSION)')
    print('prête     :', version_of(STAGED) or '—')
    print('publiée   :', (latest_release() or {}).get('version', '—'))
  elif arg in ('', '--check'):
    check()
  else:
    print(__doc__)
    sys.exit(2)


if __name__ == '__main__':
  try:
    main()
  except (subprocess.CalledProcessError, RuntimeError, OSError,
          ValueError) as error:
    print(f'glyphe-update : {error}', file=sys.stderr)
    sys.exit(1)
