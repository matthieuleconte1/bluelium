+void PinnedActionToolbarButton::UpdateColorsAndInsets() {
+  ToolbarButton::UpdateColorsAndInsets();
+  if (action_id_ != kActionSidePanelShowGlypheAssistant || !GetColorProvider()) {
+    return;
+  }
+  const auto* colors = GetColorProvider();
+  const bool glyphe_active = IsActive();
+  // Repos : logo monochrome sur pastille discrète. Panneau ouvert : pastille
+  // pleine à l'accent (bleu de la planche), logo de la couleur opposée.
+  // Panneau ouvert : pastille pleine à la couleur du thème (sa pastille dans
+  // Personnaliser, #3450d1 pour Prism) et logo blanc. Repos : logo noir ou
+  // blanc selon le thème, sur une pastille discrète.
+  SkColor seed = ui::kGlyphePrismSeed;
+  if (const ThemeService* theme =
+          ThemeServiceFactory::GetForProfile(browser_->GetProfile());
+      theme && !theme->GetIsGrayscale() && theme->GetUserColor()) {
+    seed = *theme->GetUserColor();
+  }
+  const SkColor icon = glyphe_active
+                           ? SK_ColorWHITE
+                           : colors->GetColor(ui::kColorSysOnSurface);
+  const SkColor background =
+      glyphe_active
+          ? seed
+          : color_utils::AlphaBlend(icon, colors->GetColor(kColorToolbar),
+                                    SkAlpha{0x14});
+  SetBackground(views::CreateRoundedRectBackground(background, 15));
+  // Survol, appui et anneau de focus ronds, comme la pastille.
+  views::InstallCircleHighlightPathGenerator(this);
+  gfx::ImageSkia logo = glyphe::AssistantIcon(
+      glyphe::CurrentAssistant(browser_->GetProfile())).Rasterize(colors);
+  logo = gfx::ImageSkiaOperations::CreateColorMask(logo, icon);
+  for (auto state : {STATE_NORMAL, STATE_HOVERED, STATE_PRESSED}) {
+    SetImageModel(state, ui::ImageModel::FromImageSkia(logo));
+  }
+  if (status_indicator_) {
+    status_indicator_->Hide();
+  }
+}
