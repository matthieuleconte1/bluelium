+std::u16string ExtensionActionViewModel::GetGlypheBadgeText(
+    content::WebContents* web_contents) const {
+  if (!ExtensionIsValid() || !web_contents) {
+    return u"0";
+  }
+  const std::string text = extension_action_->GetDisplayBadgeText(
+      sessions::SessionTabHelper::IdForTab(web_contents).id());
+  return text.empty() ? u"0" : base::UTF8ToUTF16(text);
+}
