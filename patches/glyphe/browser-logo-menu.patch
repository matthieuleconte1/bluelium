+
+void BrowserAppMenuButton::ShowMenu() {
+  // Bluelium : Alt+F / Alt+E et ShowAppMenu ouvrent le menu sous le logo.
+  if (BrowserLogoMenuButton* logo = GetActiveLogoMenuButton()) {
+    logo->ActivateMenu();
+    return;
+  }
+  if (views::View::IsDrawn()) {
+    AppMenuButton::ShowMenu();
+    return;
+  }
+  ShowMenuWithFlags(views::MenuRunner::SHOULD_SHOW_MNEMONICS |
+                    views::MenuRunner::INVOKED_FROM_KEYBOARD);
