+  if (horizontal_tab_strip_region_view_) {
+    if (auto* button = horizontal_tab_strip_region_view_->GetLogoMenuButton()) {
+      buttons.push_back(button);
+    }
+  }
+  if (vertical_tab_strip_region_view_) {
+    if (auto* button = vertical_tab_strip_region_view_->GetLogoMenuButton()) {
+      buttons.push_back(button);
+    }
+  }
+  return buttons;
+}
