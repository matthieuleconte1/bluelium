+
+void BrowserAppMenuButton::Focus(views::AccessiblePaneView* pane) {
+  if (views::View::IsDrawn()) {
+    AppMenuButton::Focus(pane);
+    return;
+  }
+  if (BrowserLogoMenuButton* logo = GetActiveLogoMenuButton()) {
+    if (BrowserView* browser_view = toolbar_view_->browser_view()) {
+      if (TabStripRegionView* region = browser_view->tab_strip_view()) {
+        region->SetPaneFocus(logo);
+        return;
+      }
+    }
+    logo->RequestFocus();
+    return;
+  }
+  AppMenuButton::Focus(pane);
+}
