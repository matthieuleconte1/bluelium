+void ToolbarView::OnPaint(gfx::Canvas* canvas) {
+  views::AccessiblePaneView::OnPaint(canvas);
+  if (ui::BlueliumDarkOutline() && browser_view_->ShouldDrawTabStrip()) {
+    cc::PaintFlags flags;
+    flags.setColor(ui::BlueliumDarkOutlineDivider());
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(1.f);
+    const float intervals[] = {1.f, 1.f};
+    flags.setPathEffect(cc::PathEffect::MakeDash(intervals, 2, 0));
+    // Commence aux onglets : rien sous les feux macOS.
+    float start = 0;
+    if (views::View* tabs = browser_view_->tab_strip_view()) {
+      gfx::Point origin;
+      views::View::ConvertPointToTarget(tabs, this, &origin);
+      start = std::clamp<float>(origin.x(), 0, width());
+    }
+    canvas->DrawLine(gfx::PointF(start, 0.5f), gfx::PointF(width(), 0.5f), flags);
+  }
+}
