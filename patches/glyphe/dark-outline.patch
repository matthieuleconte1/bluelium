+    flags.setAntiAlias(false);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(scale);
+    flags.setColor(ui::BlueliumDarkOutlineDivider());
+    const float intervals[] = {scale, scale};  // Bluelium : point 1 px, pas 2 px.
+    flags.setPathEffect(cc::PathEffect::MakeDash(intervals, 2, 0));
+    canvas->DrawLine(gfx::PointF(x, 13 * scale), gfx::PointF(x, 27 * scale), flags);
