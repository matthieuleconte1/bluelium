+/* Bluelium : le jeu, le texte puis les boutons arrivent en fondu. */
+@keyframes bluelium-page-enter {
+  from {
+    opacity: 0;
+    translate: 0 8px;
+  }
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  .interstitial-wrapper > *,
+  #buttons {
+    animation: bluelium-page-enter 280ms cubic-bezier(0.2, 0.8, 0.2, 1)
+        backwards;
+    animation-delay: calc((min(sibling-index(), 6) - 1) * 40ms);
