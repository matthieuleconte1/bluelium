+void ExtensionsToolbarDesktop::OnPaintBackground(gfx::Canvas* canvas) {
+  ToolbarIconContainerView::OnPaintBackground(canvas);
+  const gfx::Rect bounds = GetLocalBounds();
+  if (bounds.IsEmpty()) {
+    return;
+  }
+  const auto* colors = GetColorProvider();
+  if (!colors) {
+    return;
+  }
+  // Bluelium : pastille arrondie regroupant les extensions et le puzzle.
+  const SkColor page_bg =
+      colors->GetColor(kColorGlyphePageColorButtonBackground);
+  const bool has_page_box = SkColorGetA(page_bg) != SK_AlphaTRANSPARENT;
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kFill_Style);
+  if (ui::BlueliumDarkOutline() && !has_page_box) {
+    // Bluelium : OLED / Nuit (« Trait fin ») : fond discret + contour fin.
+    flags.setColor(color_utils::AlphaBlend(
+        colors->GetColor(kColorToolbarButtonIcon),
+        colors->GetColor(kColorToolbar), SkAlpha{0x10}));
+    canvas->DrawRoundRect(gfx::RectF(bounds), kBlueliumGroupCornerRadius,
+                          flags);
+    cc::PaintFlags stroke;
+    stroke.setAntiAlias(true);
+    stroke.setStyle(cc::PaintFlags::kStroke_Style);
+    stroke.setStrokeWidth(1.0f);
+    stroke.setColor(colors->GetColor(kColorToolbarSeparatorDefault));
+    gfx::RectF stroke_rect(bounds);
+    stroke_rect.Inset(0.5f);
+    canvas->DrawRoundRect(stroke_rect, kBlueliumGroupCornerRadius - 0.5f,
+                          stroke);
+    return;
+  }
+  flags.setColor(
+      has_page_box
+          ? page_bg
+          : color_utils::AlphaBlend(
+                colors->GetColor(kColorToolbarButtonIcon),
+                colors->GetColor(kColorToolbar), SkAlpha{0x14}));
+  canvas->DrawRoundRect(gfx::RectF(bounds), kBlueliumGroupCornerRadius, flags);
 }
 
