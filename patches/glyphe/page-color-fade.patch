+
+void BrowserWidget::UpdateGlyphePageColor(bool immediate) {
+  if (!browser_view_) {
+    return;
+  }
+  Profile* profile = browser_view_->browser()->GetProfile();
+  const bool follow =
+      !ui::IsGlypheRedNight() &&
+      !web_app::AppBrowserController::From(browser_view_->browser()) &&
+      profile->GetPrefs()->GetBoolean(prefs::kGlypheFollowPageColor);
+  std::optional<SkColor> target;
+  // Nouvel onglet : couleurs du thème, comme Shimmer qui les suit.
+  content::WebContents* active = browser_view_->GetActiveWebContents();
+  const bool new_tab_page =
+      active && active->GetVisibleURL().SchemeIs("chrome") &&
+      (active->GetVisibleURL().host() == "new-tab-page" ||
+       active->GetVisibleURL().host() == "newtab");
+  if (follow && !new_tab_page) {
+    content::WebContents* contents = active;
+    std::optional<SkColor> page;
+    if (contents) {
+      page = contents->GetThemeColor();
+      if (!page || SkColorGetA(*page) == SK_AlphaTRANSPARENT) {
+        page = contents->GetBackgroundColor();
+      }
+    }
+    if (!page || SkColorGetA(*page) == SK_AlphaTRANSPARENT) {
+      // Couleur pas encore connue (chargement) : on garde la précédente
+      // plutôt que de repasser par le thème.
+      if (glyphe_target_page_color_) {
+        return;
+      }
+    } else {
+      // theme-color souvent semi-transparente (YouTube) : rendue opaque.
+      target = SkColorSetA(*page, SK_AlphaOPAQUE);
+    }
+  }
+  if (target == glyphe_target_page_color_) {
+    if (immediate && glyphe_settle_timer_.IsRunning()) {
+      glyphe_settle_timer_.Stop();
+      StartGlyphePageColorFade();
+    }
+    return;
+  }
+  glyphe_target_page_color_ = target;
+  if (immediate || !target || !glyphe_shown_page_color_) {
+    glyphe_settle_timer_.Stop();
+    StartGlyphePageColorFade();
+    return;
+  }
+  // Pendant un chargement la couleur change plusieurs fois de suite (fond
+  // blanc, puis celui du site) : on attend qu’elle se stabilise.
+  glyphe_settle_timer_.Start(
+      FROM_HERE, base::Milliseconds(120),
+      base::BindOnce(&BrowserWidget::StartGlyphePageColorFade,
+                     base::Unretained(this)));
+}
+
+void BrowserWidget::StartGlyphePageColorFade() {
+  if (!glyphe_target_page_color_ || !glyphe_shown_page_color_ ||
+      *glyphe_target_page_color_ == *glyphe_shown_page_color_) {
+    // Activation, désactivation ou rien à animer : passage direct.
+    glyphe_fade_timer_.Stop();
+    FinishGlyphePageColorFade();
+    return;
+  }
+  glyphe_fade_from_ = *glyphe_shown_page_color_;
+  glyphe_fade_start_ = base::TimeTicks::Now();
+  glyphe_fade_timer_.Start(
+      FROM_HERE, base::Milliseconds(33),
+      base::BindRepeating(&BrowserWidget::StepGlyphePageColorFade,
+                          base::Unretained(this)));
+  StepGlyphePageColorFade();
+}
+
+void BrowserWidget::StepGlyphePageColorFade() {
+  constexpr base::TimeDelta kDuration = base::Milliseconds(240);
+  const double t = std::clamp(
+      (base::TimeTicks::Now() - glyphe_fade_start_) / kDuration, 0.0, 1.0);
+  if (t >= 1.0 || !glyphe_target_page_color_) {
+    glyphe_fade_timer_.Stop();
+    FinishGlyphePageColorFade();
+    return;
+  }
+  const float eased = static_cast<float>(
+      gfx::Tween::CalculateValue(gfx::Tween::EASE_IN_OUT, t));
+  const SkColor color = color_utils::AlphaBlend(
+      *glyphe_target_page_color_, glyphe_fade_from_, eased);
+  if (glyphe_shown_page_color_ == color) {
+    return;
+  }
+  glyphe_shown_page_color_ = color;
+  glyphe_fade_steps_.push_back(color);
+  ThemeChanged();
+}
+
+void BrowserWidget::FinishGlyphePageColorFade() {
+  const bool changed = glyphe_shown_page_color_ != glyphe_target_page_color_;
+  glyphe_shown_page_color_ = glyphe_target_page_color_;
+  if (changed) {
+    ThemeChanged();
+  }
+  if (glyphe_fade_steps_.empty()) {
+    return;
+  }
+  // Les teintes intermédiaires ne resservent pas : le cache des
+  // fournisseurs de couleurs n’a pas de limite, on les libère.
+  std::vector<SkColor> steps;
+  steps.swap(glyphe_fade_steps_);
+  const std::optional<SkColor> keep = glyphe_shown_page_color_;
+  ui::ColorProviderManager::Get().EraseColorProvidersIf(
+      [&](const ui::ColorProviderKey& key) {
+        return !key.app_controller && key.app_background_color &&
+               key.app_background_color != keep &&
+               std::ranges::contains(steps, *key.app_background_color);
+      });
 }
 
