+void CustomizeColorSchemeModeHandler::SetRedNightSchedule(
+    bool enabled, int32_t start_minutes, int32_t end_minutes) {
+  if (start_minutes < 0 || start_minutes >= 1440 ||
+      end_minutes < 0 || end_minutes >= 1440) {
+    UpdateRedNightSchedule();  // Bluelium : renvoyer les valeurs retenues.
+    return;
+  }
+  PrefService* prefs = glyphe_prefs_.prefs();
+  // Bluelium : coalescer les trois notifications dans le planificateur.
+  prefs->SetInteger(prefs::kGlypheRedNightAutoStart, start_minutes);
+  prefs->SetInteger(prefs::kGlypheRedNightAutoEnd, end_minutes);
+  prefs->SetBoolean(prefs::kGlypheRedNightAutoEnabled, enabled);
+  UpdateRedNightSchedule();
+}
+
+void CustomizeColorSchemeModeHandler::UpdateRedNightSchedule() {
+  const PrefService* prefs = glyphe_prefs_.prefs();
+  remote_client_->SetRedNightSchedule(
+      prefs->GetBoolean(prefs::kGlypheRedNightAutoEnabled),
+      prefs->GetInteger(prefs::kGlypheRedNightAutoStart),
+      prefs->GetInteger(prefs::kGlypheRedNightAutoEnd));
 }
 
