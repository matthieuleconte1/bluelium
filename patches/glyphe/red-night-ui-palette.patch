+  // Palette de l’interface : globale, rafraîchie seulement si elle change.
+  if (glyphe_pref_registrar_.prefs()) {
+    const bool glyphe_on = glyphe_pref_registrar_.prefs()->GetBoolean(
+        prefs::kGlypheRedNightEnabled);
+    if (ui::IsGlypheRedNight() != glyphe_on) {
+      ui::SetGlypheRedNight(glyphe_on);
+      ui::ColorProviderManager::Get().ResetColorProviderCache();
+      ui::NativeTheme::GetInstanceForNativeUi()->NotifyOnNativeThemeUpdated();
+    }
+  }
