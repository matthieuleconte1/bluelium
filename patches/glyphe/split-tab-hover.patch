+      !drag_data_.dragging_groups.empty() ||
+      drag_data_.tab_drag_data_.size() != 1 ||
+      drag_data_.num_dragging_tabs() != 1) {
+    return false;
+  }
+  TabStripModel* model = attached_context_->GetTabStripModel();
+  if (!model || !model->profile() || !model->profile()->GetPrefs() ||
+      !model->profile()->GetPrefs()->GetBoolean(
+          prefs::kBlueliumSplitOnTabHover)) {
+    return false;
+  }
+  BrowserWindowInterface* bwi =
+      model->delegate() ? model->delegate()->GetBrowserWindowInterface()
+                        : nullptr;
+  if (!bwi || bwi->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    return false;
+  }
+  content::WebContents* dragged_contents =
+      drag_data_.source_dragged_contents();
+  if (!dragged_contents) {
+    return false;
+  }
+  const int dragged_idx = model->GetIndexOfWebContents(dragged_contents);
+  if (dragged_idx == TabStripModel::kNoTab ||
+      model->GetSplitForTab(dragged_idx).has_value()) {
+    return false;
+  }
+  return true;
+}
+
+DraggingTabsSession::SplitHoverZone DraggingTabsSession::FindSplitHoverHit(
+    const gfx::Rect& dragged_bounds,
+    Tab** out_target_tab,
+    tabs::TabHandle* out_target_handle) const {
+  *out_target_tab = nullptr;
+  *out_target_handle = tabs::TabHandle::Null();
+  TabStripModel* model = attached_context_->GetTabStripModel();
+  const int dragged_idx =
+      model->GetIndexOfWebContents(drag_data_.source_dragged_contents());
+  if (dragged_idx == TabStripModel::kNoTab) {
+    return SplitHoverZone::kNone;
+  }
+  const bool dragged_pinned = model->IsTabPinned(dragged_idx);
+  const std::optional<tab_groups::TabGroupId> focused_group =
+      model->GetFocusedGroup();
+  const int dragged_center_x = dragged_bounds.CenterPoint().x();
+
+  for (int i = 0; i < model->count(); ++i) {
+    if (i == dragged_idx || model->IsTabPinned(i) != dragged_pinned ||
+        model->GetSplitForTab(i).has_value()) {
+      continue;
+    }
+    if (focused_group.has_value() && !dragged_pinned &&
+        model->GetTabGroupForTab(i) != focused_group) {
+      continue;
+    }
+    Tab* tab = views::AsViewClass<Tab>(drag_position_delegate_->GetTabAt(i));
+    if (!tab || !tab->GetVisible() || tab->closing() || tab->dragging() ||
+        !tab->parent()) {
+      continue;
+    }
+    const gfx::Rect bounds = ToEnclosingRect(views::View::ConvertRectToTarget(
+        tab->parent(), base::to_address(attached_context_),
+        gfx::RectF(tab->bounds())));
+    if (bounds.width() <= 0 || dragged_center_x < bounds.x() ||
+        dragged_center_x >= bounds.right()) {
+      continue;
+    }
+    const int margin =
+        base::ClampRound(bounds.width() * kBlueliumSplitHoverEdgeMarginRatio);
+    const int center_left = bounds.x() + margin;
+    const int center_right = bounds.right() - margin;
+    if (dragged_center_x >= center_left && dragged_center_x <= center_right) {
+      *out_target_tab = tab;
+      *out_target_handle = tab->tab_handle();
+      return SplitHoverZone::kCenter;
+    }
+    const bool approaching =
+        (i > dragged_idx && dragged_center_x < center_left) ||
+        (i < dragged_idx && dragged_center_x > center_right);
+    if (approaching) {
+      *out_target_tab = tab;
+      *out_target_handle = tab->tab_handle();
+      return SplitHoverZone::kApproachEdge;
+    }
+    return SplitHoverZone::kNone;
+  }
+  return SplitHoverZone::kNone;
+}
+
+void DraggingTabsSession::UpdateSplitHover(SplitHoverZone zone,
+                                           Tab* target_tab,
+                                           tabs::TabHandle target_handle) {
+  if (zone != SplitHoverZone::kCenter || !target_tab ||
+      target_handle == tabs::TabHandle::Null()) {
+    ResetSplitHover();
+    return;
+  }
+  if (target_handle == split_hover_candidate_handle_) {
+    return;
+  }
+  ClearSplitHoverVisuals();
+  split_hover_confirmed_ = false;
+  split_hover_candidate_handle_ = target_handle;
+  split_hover_candidate_view_.SetView(target_tab);
+  split_hover_timer_.Start(
+      FROM_HERE, kBlueliumSplitHoverDelay,
+      base::BindOnce(&DraggingTabsSession::OnSplitHoverTimerFired,
+                     base::Unretained(this)));
+}
+
+void DraggingTabsSession::OnSplitHoverTimerFired() {
+  if (!IsEligibleForSplitHover() || !split_hover_candidate_handle_.Get()) {
+    ResetSplitHover();
+    return;
+  }
+  Tab* target_tab =
+      views::AsViewClass<Tab>(split_hover_candidate_view_.view());
+  if (!target_tab) {
+    ResetSplitHover();
+    return;
+  }
+  split_hover_confirmed_ = true;
+  target_tab->SetBlueliumSplitHoverHighlight(true);
+  split_hover_highlighted_target_view_.SetView(target_tab);
+  if (Tab* dragged_tab = views::AsViewClass<Tab>(
+          drag_data_.source_view_drag_data()->attached_view)) {
+    dragged_tab->SetBlueliumSplitHoverHighlight(true);
+    split_hover_highlighted_dragged_view_.SetView(dragged_tab);
+  }
+}
+
+void DraggingTabsSession::ClearSplitHoverVisuals() {
+  if (Tab* target = views::AsViewClass<Tab>(
+          split_hover_highlighted_target_view_.view())) {
+    target->SetBlueliumSplitHoverHighlight(false);
+  }
+  split_hover_highlighted_target_view_.SetView(nullptr);
+  if (Tab* dragged = views::AsViewClass<Tab>(
+          split_hover_highlighted_dragged_view_.view())) {
+    dragged->SetBlueliumSplitHoverHighlight(false);
+  }
+  split_hover_highlighted_dragged_view_.SetView(nullptr);
+}
+
+void DraggingTabsSession::ResetSplitHover() {
+  split_hover_timer_.Stop();
+  ClearSplitHoverVisuals();
+  split_hover_confirmed_ = false;
+  split_hover_candidate_handle_ = tabs::TabHandle::Null();
+  split_hover_candidate_view_.SetView(nullptr);
+}
