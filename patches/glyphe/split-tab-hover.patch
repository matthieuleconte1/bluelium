+    return false;
+  }
+  const int dragged_idx = model->GetIndexOfWebContents(dragged_contents);
+  if (dragged_idx == TabStripModel::kNoTab ||
+      model->GetSplitForTab(dragged_idx).has_value()) {
+    return false;
+  }
+  return true;
+}
+
+DraggedTabsContainer::SplitHoverZone DraggedTabsContainer::FindSplitHoverHit(
+    const views::ProposedLayout& layout,
+    const gfx::Rect& dragged_tab_bounds,
+    TabView** out_target_view,
+    tabs::TabHandle* out_target_handle) {
+  *out_target_view = nullptr;
+  *out_target_handle = tabs::TabHandle::Null();
+  TabDragHandler& drag_handler = GetDragHandler();
+  TabDragController* controller = drag_handler.GetDragController();
+  TabStripModel* model = drag_handler.GetTabStripModel();
+  if (!controller || !model) {
+    return SplitHoverZone::kNone;
+  }
+  const int dragged_idx = model->GetIndexOfWebContents(
+      controller->GetSessionData().source_dragged_contents());
+  if (dragged_idx == TabStripModel::kNoTab) {
+    return SplitHoverZone::kNone;
+  }
+  const bool dragged_pinned = model->IsTabPinned(dragged_idx);
+  const std::optional<tab_groups::TabGroupId> focused_group =
+      model->GetFocusedGroup();
+
+  gfx::Rect logical_drag_bounds = dragged_tab_bounds;
+  if (base::i18n::IsRTL() && IsHorizontalDragSupported()) {
+    logical_drag_bounds.set_x(
+        host_view_->GetMirroredXForRect(logical_drag_bounds));
+  }
+  const gfx::Point drag_center = logical_drag_bounds.CenterPoint();
+
+  for (const auto& child_layout : layout.child_layouts) {
+    if (!child_layout.visible ||
+        drag_handler.IsViewDragging(*child_layout.child_view)) {
+      continue;
+    }
+    const TabCollectionNode* child_node =
+        GetCollectionNodeFromView(*child_layout.child_view);
+    if (!child_node || child_node->type() != TabCollectionNode::Type::TAB) {
+      continue;
+    }
+    TabView* tab_view = views::AsViewClass<TabView>(child_layout.child_view);
+    if (!tab_view || tab_view->split()) {
+      continue;
+    }
+    const tabs::TabInterface* target_tab = tab_view->GetTabInterface();
+    if (!target_tab || target_tab->IsSplit()) {
+      continue;
+    }
+    const int target_idx = model->GetIndexOfTab(target_tab);
+    if (target_idx == TabStripModel::kNoTab || target_idx == dragged_idx ||
+        model->IsTabPinned(target_idx) != dragged_pinned ||
+        model->GetSplitForTab(target_idx).has_value()) {
+      continue;
+    }
+    if (focused_group.has_value() && !dragged_pinned &&
+        model->GetTabGroupForTab(target_idx) != focused_group) {
+      continue;
+    }
+
+    const gfx::Rect& b = child_layout.bounds;
+    const bool target_is_after = target_idx > dragged_idx;
+    if (drag_axes_ == DragAxes::kVerticalOnly) {
+      if (b.height() <= 0 || drag_center.y() < b.y() ||
+          drag_center.y() >= b.bottom()) {
+        continue;
+      }
+      const int margin =
+          base::ClampRound(b.height() * kBlueliumSplitHoverEdgeMarginRatio);
+      const int center_top = b.y() + margin;
+      const int center_bottom = b.bottom() - margin;
+      if (drag_center.y() >= center_top && drag_center.y() <= center_bottom) {
+        *out_target_view = tab_view;
+        *out_target_handle = target_tab->GetHandle();
+        return SplitHoverZone::kCenter;
+      }
+      const bool approaching =
+          (target_is_after && drag_center.y() < center_top) ||
+          (!target_is_after && drag_center.y() > center_bottom);
+      if (approaching) {
+        *out_target_view = tab_view;
+        *out_target_handle = target_tab->GetHandle();
+        return SplitHoverZone::kApproachEdge;
+      }
+      return SplitHoverZone::kNone;
+    } else if (drag_axes_ == DragAxes::kHorizontalOnly) {
+      if (b.width() <= 0 || drag_center.x() < b.x() ||
+          drag_center.x() >= b.right()) {
+        continue;
+      }
+      const int margin =
+          base::ClampRound(b.width() * kBlueliumSplitHoverEdgeMarginRatio);
+      const int center_left = b.x() + margin;
+      const int center_right = b.right() - margin;
+      if (drag_center.x() >= center_left && drag_center.x() <= center_right) {
+        *out_target_view = tab_view;
+        *out_target_handle = target_tab->GetHandle();
+        return SplitHoverZone::kCenter;
+      }
+      const bool approaching =
+          (target_is_after && drag_center.x() < center_left) ||
+          (!target_is_after && drag_center.x() > center_right);
+      if (approaching) {
+        *out_target_view = tab_view;
+        *out_target_handle = target_tab->GetHandle();
+        return SplitHoverZone::kApproachEdge;
+      }
+      return SplitHoverZone::kNone;
+    } else {
+      // Grille 2D (onglets épinglés verticaux).
+      if (!b.Contains(drag_center)) {
+        continue;
+      }
+      const int mx =
+          base::ClampRound(b.width() * kBlueliumSplitHoverEdgeMarginRatio);
+      const int my =
+          base::ClampRound(b.height() * kBlueliumSplitHoverEdgeMarginRatio);
+      const gfx::Rect inner(b.x() + mx, b.y() + my,
+                            std::max(1, b.width() - 2 * mx),
+                            std::max(1, b.height() - 2 * my));
+      if (inner.Contains(drag_center)) {
+        *out_target_view = tab_view;
+        *out_target_handle = target_tab->GetHandle();
+        return SplitHoverZone::kCenter;
+      }
+      const bool approaching =
+          (target_is_after && drag_center.x() <= inner.right() &&
+           drag_center.y() <= inner.bottom()) ||
+          (!target_is_after && drag_center.x() >= inner.x() &&
+           drag_center.y() >= inner.y());
+      if (approaching) {
+        *out_target_view = tab_view;
+        *out_target_handle = target_tab->GetHandle();
+        return SplitHoverZone::kApproachEdge;
+      }
+      return SplitHoverZone::kNone;
+    }
+  }
+  return SplitHoverZone::kNone;
+}
+
+void DraggedTabsContainer::UpdateSplitHover(SplitHoverZone zone,
+                                            TabView* target_view,
+                                            tabs::TabHandle target_handle) {
+  if (zone != SplitHoverZone::kCenter || !target_view ||
+      target_handle == tabs::TabHandle::Null()) {
+    ResetSplitHover();
+    return;
+  }
+  if (target_handle == split_hover_candidate_handle_) {
+    return;
+  }
+  ClearSplitHoverVisuals();
+  split_hover_confirmed_ = false;
+  split_hover_candidate_handle_ = target_handle;
+  split_hover_candidate_view_.SetView(target_view);
+  split_hover_timer_.Start(
+      FROM_HERE, kBlueliumSplitHoverDelay,
+      base::BindOnce(&DraggedTabsContainer::OnSplitHoverTimerFired,
+                     base::Unretained(this)));
+}
+
+void DraggedTabsContainer::OnSplitHoverTimerFired() {
+  if (!collection_node_ || !collection_node_->GetController() ||
+      !GetDragHandler().IsDragging() || !IsEligibleForSplitHover() ||
+      !split_hover_candidate_handle_.Get()) {
+    ResetSplitHover();
+    return;
+  }
+  TabView* target_view =
+      views::AsViewClass<TabView>(split_hover_candidate_view_.view());
+  if (!target_view) {
+    ResetSplitHover();
+    return;
+  }
+  split_hover_confirmed_ = true;
+  target_view->SetBlueliumSplitHoverHighlight(true);
+  split_hover_highlighted_target_view_.SetView(target_view);
+  if (dragging_views_.size() == 1) {
+    views::View* dragged_view = dragging_views_.begin()->first.get();
+    if (dragged_view && dragged_view->layer()) {
+      dragged_view->layer()->SetOpacity(kBlueliumSplitHoverDraggedOpacity);
+      split_hover_faded_dragged_view_.SetView(dragged_view);
+    } else if (TabView* dragged_tab =
+                   views::AsViewClass<TabView>(dragged_view)) {
+      dragged_tab->SetBlueliumSplitHoverHighlight(true);
+      split_hover_highlighted_dragged_view_.SetView(dragged_tab);
+    }
+  }
+}
+
+void DraggedTabsContainer::ClearSplitHoverVisuals() {
+  if (TabView* target = views::AsViewClass<TabView>(
+          split_hover_highlighted_target_view_.view())) {
+    target->SetBlueliumSplitHoverHighlight(false);
+  }
+  split_hover_highlighted_target_view_.SetView(nullptr);
+  if (TabView* dragged = views::AsViewClass<TabView>(
+          split_hover_highlighted_dragged_view_.view())) {
+    dragged->SetBlueliumSplitHoverHighlight(false);
+  }
+  split_hover_highlighted_dragged_view_.SetView(nullptr);
+  if (views::View* faded = split_hover_faded_dragged_view_.view()) {
+    if (faded->layer()) {
+      faded->layer()->SetOpacity(1.0f);
+    }
+  }
+  split_hover_faded_dragged_view_.SetView(nullptr);
+}
+
+void DraggedTabsContainer::ResetSplitHover() {
+  split_hover_timer_.Stop();
+  ClearSplitHoverVisuals();
+  split_hover_confirmed_ = false;
+  split_hover_candidate_handle_ = tabs::TabHandle::Null();
+  split_hover_candidate_view_.SetView(nullptr);
+}
