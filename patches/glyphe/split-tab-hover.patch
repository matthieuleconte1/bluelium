+tabs::TabHandle DraggingTabsSession::TakeConfirmedSplitTarget() {
+  tabs::TabHandle result;
+  if (split_hover_confirmed_ && split_hover_candidate_handle_.Get()) {
+    result = split_hover_candidate_handle_;
+  }
+  ResetSplitHover();
+  split_hover_deferred_move_ = false;
+  return result;
+}
+
+void DraggingTabsSession::FlushDeferredMoveForDrop() {
+  const bool needs_flush =
+      split_hover_deferred_move_ && !split_hover_confirmed_;
+  ResetSplitHover();
+  split_hover_deferred_move_ = false;
+  if (needs_flush) {
+    MoveAttachedImpl(last_point_in_screen_, /*just_attached=*/false,
+                     /*allow_split_hover=*/false);
+  }
+}
