 void Tab::OnPaint(gfx::Canvas* canvas) {
   tab_style_views()->PaintTab(canvas);
+
+  // Glyphe : onglet combiné de la vue divisée (segment actif + icône).
+  if (!split().has_value() || !GetColorProvider()) {
+    return;
+  }
+  const std::vector<Tab*> pair = controller()->GetTabsInSplit(this);
+  if (pair.size() != 2) {
+    return;
+  }
+  const bool is_left = pair[base::i18n::IsRTL() ? 1 : 0] == this;
+  const gfx::RectF pill = gfx::SkRectToRectF(
+      tab_style_views()
+          ->GetPath(TabStyle::PathType::kActiveTab, 1.0f, TabPathFlags())
+          .getBounds());
+  // Jonction : bord droit de l'onglet de gauche, x=1 dans celui de droite.
+  const float junction = is_left ? width() : 1.0f;
+  constexpr float kInset = 3.0f;
+  constexpr float kIconSize = 14.0f;
+  constexpr float kIconGap = 3.0f;
+  const float half_zone = kIconSize / 2 + kIconGap;
+
+  if (IsActive() && controller_->IsActiveTab(this)) {
+    gfx::RectF segment = pill;
+    segment.Inset(kInset);
+    if (is_left) {
+      segment.set_width(junction - half_zone - segment.x());
+    } else {
+      const float right = segment.right();
+      segment.set_x(junction + half_zone);
+      segment.set_width(right - segment.x());
+    }
+    if (!segment.IsEmpty()) {
+      cc::PaintFlags flags;
+      flags.setAntiAlias(true);
+      flags.setColor(SkColorSetA(
+          GetColorProvider()->GetColor(ui::kColorSysPrimary), 0x1A));
+      canvas->DrawRoundRect(segment, 6.0f, flags);
+    }
+  }
+
+  const SkColor foreground =
+      tab_style_views()->CalculateTargetColors().foreground_color;
+  canvas->Save();
+  if (!is_left) {
+    // Colonne x=0 déjà couverte par l'onglet de gauche.
+    canvas->ClipRect(gfx::Rect(1, 0, width() - 1, height()));
+  }
+  canvas->Translate(gfx::Vector2d(
+      static_cast<int>(junction - kIconSize / 2),
+      static_cast<int>(pill.CenterPoint().y() - kIconSize / 2)));
+  gfx::PaintVectorIcon(canvas, vector_icons::kGlypheSplitIcon,
+                       static_cast<int>(kIconSize),
+                       SkColorSetA(foreground, 0x99));
+  canvas->Restore();
 }
 
