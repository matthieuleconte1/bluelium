+// Bluelium : pages internes et pages d'erreur où le bloqueur n'agit pas.
+bool IsBlueliumInternalPage(content::WebContents* web_contents) {
+  if (!web_contents) {
+    return true;
+  }
+  const auto* main_frame = web_contents->GetPrimaryMainFrame();
+  if (main_frame && main_frame->IsErrorDocument()) {
+    return true;
+  }
+  const GURL& committed_url = web_contents->GetLastCommittedURL();
+  const GURL& page_url =
+      committed_url.is_empty() ? web_contents->GetVisibleURL() : committed_url;
+  if (page_url.is_empty()) {
+    return true;
+  }
+  return page_url.SchemeIs(content::kChromeUIScheme) ||
+         page_url.SchemeIs(content::kChromeUIUntrustedScheme) ||
+         page_url.SchemeIs(content::kChromeDevToolsScheme) ||
+         page_url.SchemeIs(content::kChromeErrorScheme) ||
+         page_url.SchemeIs(content::kChromeNativeScheme) ||
+         page_url.SchemeIs(content::kHeliumUIScheme) ||
+         page_url.SchemeIs("helium") ||
+         page_url.SchemeIs(url::kAboutScheme);
+}
