+// Bluelium : déterminer si le bouclier doit apparaître pour l'onglet actif.
+bool ExtensionsToolbarDesktop::ShouldShowBlueliumBlocker() const {
+  if (ShouldForceVisibility(kBlueliumBlockerActionId)) {
+    return true;
+  }
+  if (!browser_ || !model_ ||
+      !ToolbarActionsModel::CanShowActionsInToolbar(*browser_) ||
+      !model_->IsActionPinned(kBlueliumBlockerActionId)) {
+    return false;
+  }
+  tabs::TabInterface* const tab = browser_->GetActiveTabInterface();
+  content::WebContents* const web_contents = tab ? tab->GetContents() : nullptr;
+  return !IsBlueliumInternalPage(web_contents);
+}
+
+void ExtensionsToolbarDesktop::UpdateBlueliumBlockerVisibility() {
+  ToolbarActionView* const blocker = GetViewForId(kBlueliumBlockerActionId);
+  const bool visible = blocker && ShouldShowBlueliumBlocker();
+  if (blocker && blocker->parent() != this) {
+    blocker->SetVisible(visible);
+  }
+  if (bluelium_blocker_host_) {
+    bluelium_blocker_host_->SetVisible(visible);
+  }
+}
