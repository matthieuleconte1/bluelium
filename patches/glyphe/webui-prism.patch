 button {
   font-family: $i18nRaw{fontfamilyMd};
 }
+
+/* Bluelium : fond et cartes aux couleurs du thème. Les variables passent
+ * les shadow roots ; !important l'emporte sur cr_shared_vars et sur les
+ * styles propres à chaque page. */
+html:root {
+  --bluelium-page-background: var(--color-sys-header, Canvas);
+  --md-background-color: var(--bluelium-page-background) !important;
+  --color-webui-page-background: var(--bluelium-page-background) !important;
+  --color-settings-webui-page-background:
+      var(--bluelium-page-background) !important;
+  --cr-card-background-color: var(--color-sys-surface, Canvas) !important;
+  --cr-card-border-radius: 12px !important;
+  background: var(--bluelium-page-background) !important;
+}
+
+/* Bluelium : entrée de la page en fondu, avec un léger glissement. */
+@keyframes bluelium-page-enter {
+  from {
+    opacity: 0;
+    translate: 0 8px;
+  }
+}
+
+@media (prefers-reduced-motion: no-preference) {
+  body > :not(script, style, link, template, dialog) {
+    animation: bluelium-page-enter 280ms cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
+  }
+}
