+void BrowserFrameViewLinux::Layout(PassKey) {
+  LayoutSuperclass<OpaqueBrowserFrameView>(this);
+  // Glyphe : découpe arrondie de toute la zone du navigateur, pour que les
+  // vues peintes dans un calque (onglets, barre d’outils) ne débordent pas
+  // sur les coins de la fenêtre.
+  BrowserView* view = GetBrowserView();
+  if (!view) {
+    return;
+  }
+  const gfx::RoundedCornersF radii = GetWindowRoundedCorners();
+  if (!view->layer()) {
+    if (radii.IsEmpty()) {
+      return;
+    }
+    view->SetPaintToLayer();
+    view->layer()->SetFillsBoundsOpaquely(false);
+  }
+  view->layer()->SetRoundedCornerRadius(radii);
+  view->layer()->SetIsFastRoundedCorner(true);
+}
